@model TransactionDetailViewModel
@{
    ViewData["Title"] = $"Transaction - {Model.StoreName}";
}

<style>
    @@media (max-width: 767px) {
        .desktop-items { display: none !important; }
        .mobile-items { display: block !important; }
    }
    @@media (min-width: 768px) {
        .mobile-items { display: none !important; }
    }
</style>

<div class="col-lg-8 mx-auto">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Transactions</a></li>
            <li class="breadcrumb-item active">@Model.StoreName</li>
        </ol>
    </nav>

    <div class="card-custom">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="fw-semibold mb-0 fs-5">
                <i class="bi bi-receipt text-primary me-2"></i>Transaction Details
            </h4>
            <div class="btn-group">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-sm">
                    <i class="bi bi-pencil me-1"></i><span class="d-none d-md-inline">Edit</span>
                </a>
                <button type="button" class="btn btn-outline-danger btn-sm" id="deleteBtn" data-id="@Model.Id">
                    <i class="bi bi-trash me-1"></i><span class="d-none d-md-inline">Delete</span>
                </button>
            </div>
        </div>
       <div class="card-body p-4">

            @if (!string.IsNullOrEmpty(Model.ReceiptImagePath))
            {
                <div class="mb-4">
                    <img src="@Model.ReceiptImagePath" alt="Receipt" class="img-fluid rounded" style="max-height: 300px;" />
                </div>
            }

            <!-- Info Cards -->
            <div class="row g-3 mb-4">
                <div class="col-6">
                    <div class="d-flex align-items-start gap-2">
                        <div class="stat-icon flex-shrink-0" style="background: linear-gradient(135deg, #3B82F6, #06B6D4); width: 36px; height: 36px;">
                            <i class="bi bi-shop text-white small"></i>
                        </div>
                        <div>
                            <p class="text-muted small mb-0">Store</p>
                            <p class="fw-semibold mb-0">@Model.StoreName</p>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="d-flex align-items-center gap-2">
                        <div class="stat-icon flex-shrink-0" style="background: linear-gradient(135deg, #10B981, #14B8A6); width: 36px; height: 36px;">
                            <i class="bi bi-calendar text-white small"></i>
                        </div>
                        <div>
                            <p class="text-muted small mb-0">Date</p>
                            <p class="fw-semibold mb-0 small">@Model.TransactionDate.ToString("MMM dd, yyyy")</p>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="d-flex align-items-center gap-2">
                        <div class="stat-icon flex-shrink-0" style="background: linear-gradient(135deg, #F59E0B, #EA580C); width: 36px; height: 36px;">
                            <i class="bi bi-cash text-white small"></i>
                        </div>
                        <div>
                            <p class="text-muted small mb-0">Total</p>
                            <p class="fw-bold mb-0 text-primary small">@Model.TotalAmount.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</p>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="d-flex align-items-center gap-2">
                        <div class="stat-icon flex-shrink-0" style="background: linear-gradient(135deg, #8B5CF6, #7C3AED); width: 36px; height: 36px;">
                            <i class="bi bi-list-check text-white small"></i>
                        </div>
                        <div>
                            <p class="text-muted small mb-0">Items</p>
                            <p class="fw-semibold mb-0">@Model.Items.Count items</p>
                        </div>
                    </div>
                </div>
            </div>

            <hr />

            <h5 class="fw-semibold mb-3">
                <i class="bi bi-bag text-secondary me-2"></i>Items Purchased
            </h5>

            @if (Model.Items.Any())
            {
                <!-- Desktop Table -->
                <div class="table-responsive desktop-items">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Line Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.ItemName</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">@item.Price.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</td>
                                    <td class="text-end fw-semibold">@item.LineTotal.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-light">
                                <td colspan="3" class="text-end fw-semibold">Total</td>
                                <td class="text-end fw-bold text-primary">@Model.TotalAmount.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Mobile Items -->
                <div class="mobile-items">
                    @foreach (var item in Model.Items)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <div class="overflow-hidden me-2">
                               <div class="fw-medium">@item.ItemName</div>
                                <div class="text-muted small">Qty: @item.Quantity × @item.Price.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</div>
                            </div>
                            <div class="fw-semibold flex-shrink-0 text-primary">
                                @item.LineTotal.ToString("C0", new System.Globalization.CultureInfo("id-ID"))
                            </div>
                        </div>
                    }
                    <div class="d-flex justify-content-between align-items-center pt-3">
                        <span class="fw-semibold">Total</span>
                        <span class="fw-bold text-primary fs-6">@Model.TotalAmount.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</span>
                    </div>
                </div>
            }
            else
            {
                <p class="text-muted">No items recorded for this transaction.</p>
            }

           @*  <div class="text-muted small mt-4">
                <i class="bi bi-clock me-1"></i>Created: @Model.CreatedDate.ToString("MMMM dd, yyyy 'at' h:mm tt")
            </div> *@
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete Transaction</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">Are you sure you want to delete this transaction?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        document.getElementById('deleteBtn').addEventListener('click', function () {
            deleteModal.show();
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', async function () {
            showLoading();
            try {
                const response = await fetch('@Url.Action("Delete")/@Model.Id', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    }
                });
                const result = await response.json();
                if (result.success) {
                    window.location.href = '@Url.Action("Index")';
                } else {
                    showToast('danger', result.message || 'Failed to delete');
                }
            } catch (error) {
                showToast('danger', 'An error occurred');
            } finally {
                hideLoading();
                deleteModal.hide();
            }
        });
    </script>
}