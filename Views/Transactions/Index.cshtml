@model TransactionListViewModel
@{
    ViewData["Title"] = "Transactions";
}

<style>
    @@media (max-width: 767px) {
        .desktop-table {
            display: none !important;
        }

        .mobile-cards {
            display: block !important;
        }
    }

    @@media (min-width: 768px) {
        .mobile-cards {
            display: none !important;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h2 fw-bold text-dark mb-1">Transaksi</h1>
        <p class="text-muted mb-0 d-none d-md-block">Lihat dan kelola riwayat pengeluaran kamu</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-shrink-0">
        <a asp-controller="Upload" asp-action="Index" class="btn btn-gradient">
            <i class="bi bi-plus-lg me-1"></i><span class="d-none d-md-inline">Tambah Baru</span><span class="d-md-none">Tambah</span>
        </a>
        <form method="post" asp-action="Export" class="d-flex m-0">
            @Html.AntiForgeryToken()
            <input type="hidden" name="searchTerm" value="@Model.Filter.SearchTerm" />
            <input type="hidden" name="store" value="@Model.Filter.Store" />
            <input type="hidden" name="dateFrom" value="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="dateTo" value="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="minAmount" value="@Model.Filter.MinAmount" />
            <input type="hidden" name="maxAmount" value="@Model.Filter.MaxAmount" />
            <button type="submit" class="btn btn-outline-secondary" @(Model.TotalCount == 0 ? "disabled" : "")>
                <i class="bi bi-download me-1"></i><span class="d-none d-md-inline">Unduh</span>
            </button>
        </form>
    </div>
</div>

<!-- Filter Bar -->
<div class="filter-bar mb-4">
    <div class="d-md-none mb-2">
        <button class="btn btn-outline-secondary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse">
            <i class="bi bi-funnel me-2"></i>Filter & Cari
        </button>
    </div>
    <div class="collapse d-md-block" id="filterCollapse">
        <form method="get" id="filterForm">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label small text-muted">Cari</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchTerm" value="@Model.Filter.SearchTerm" class="form-control" placeholder="Nama Toko..." />
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small text-muted">Toko</label>
                    <select name="store" class="form-select">
                        <option value="">Semua Toko</option>
                        @foreach (var store in Model.Stores)
                        {
                            <option value="@store" selected="@(Model.Filter.Store == store)">@store</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small text-muted">Dari Tanggal</label>
                    <input type="date" name="dateFrom" value="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small text-muted">Sampai Tanggal</label>
                    <input type="date" name="dateTo" value="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-3 col-md-1">
                    <label class="form-label small text-muted">Min</label>
                    <input type="number" name="minAmount" value="@Model.Filter.MinAmount" step="0.01" class="form-control" placeholder="0" />
                </div>
                <div class="col-3 col-md-1">
                    <label class="form-label small text-muted">Maks</label>
                    <input type="number" name="maxAmount" value="@Model.Filter.MaxAmount" step="0.01" class="form-control" placeholder="0" />
                </div>
                <div class="col-12 col-md-1">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="bi bi-funnel"></i>
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary flex-shrink-0" title="Clear filters">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<p class="text-muted small mb-3">
    Menampilkan @Model.Transactions.Count dari @Model.TotalCount transaksi
</p>

@if (Model.Transactions.Any())
{
    <!-- Desktop Table -->
    <div class="card-custom desktop-table">
        <div class="table-responsive">
            <table class="table table-custom">
                <thead>
                    <tr>
                        <th>Toko</th>
                        <th>Tanggal</th>
                        <th>Items</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in Model.Transactions)
                    {
                        <tr data-id="@tx.Id">
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                        <i class="bi bi-shop"></i>
                                    </div>
                                    <span class="fw-medium">@tx.StoreName</span>
                                </div>
                            </td>
                            <td><span class="text-muted"><i class="bi bi-calendar me-2"></i>@tx.TransactionDate.ToString("MMM dd, yyyy")</span></td>
                            <td><span class="badge bg-light text-dark">@tx.Items.Count items</span></td>
                            <td class="text-end fw-semibold">@tx.TotalAmount.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@tx.Id" class="btn btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@tx.Id" class="btn btn-outline-warning" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn btn-outline-danger delete-btn" data-id="@tx.Id"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile Cards -->
    <div class="mobile-cards">
        @foreach (var tx in Model.Transactions)
        {
            <div class="card-custom mb-3" data-id="@tx.Id">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; flex-shrink: 0;">
                                <i class="bi bi-shop"></i>
                            </div>
                            <div>
                                <div class="fw-semibold">@tx.StoreName</div>
                                <div class="text-muted small"><i class="bi bi-calendar me-1"></i>@tx.TransactionDate.ToString("MMM dd, yyyy")</div>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-primary">@tx.TotalAmount.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</div>
                            <span class="badge bg-light text-dark small">@tx.Items.Count items</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <a asp-action="Details" asp-route-id="@tx.Id" class="btn btn-outline-primary btn-sm flex-grow-1"><i class="bi bi-eye me-1"></i>Lihat</a>
                        <a asp-action="Edit" asp-route-id="@tx.Id" class="btn btn-outline-warning btn-sm flex-grow-1"><i class="bi bi-pencil me-1"></i>Ubah</a>
                        <button type="button" class="btn btn-outline-danger btn-sm flex-grow-1 delete-btn" data-id="@tx.Id"><i class="bi bi-trash me-1"></i>Hapus</button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-store="@Model.Filter.Store"
                       asp-route-dateFrom="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")"
                       asp-route-dateTo="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i"
                           asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-store="@Model.Filter.Store"
                           asp-route-dateFrom="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-dateTo="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-store="@Model.Filter.Store"
                       asp-route-dateFrom="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")"
                       asp-route-dateTo="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="card-custom">
        <div class="card-body text-center py-5">
            <i class="bi bi-receipt" style="font-size: 4rem; color: #cbd5e1;"></i>
            <p class="text-muted mt-3">No transactions found.</p>
            @if (Model.Filter.SearchTerm != null || Model.Filter.Store != null || Model.Filter.DateFrom != null)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Clear Filters</a>
            }
            else
            {
                <a asp-controller="Upload" asp-action="Index" class="btn btn-gradient">Add Your First Transaction</a>
            }
        </div>
    </div>
}

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete Transaction</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">Are you sure you want to delete this transaction?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let deleteId = null;
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                deleteId = this.dataset.id;
                deleteModal.show();
            });
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', async function () {
            if (!deleteId) return;
            showLoading();
            try {
                const response = await fetch(`@Url.Action("Delete", "Transactions")/${deleteId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ||
                            document.querySelector('meta[name="x-request-token"]')?.content
                    }
                });
                const result = await response.json();
                if (result.success) {
                    showToast('success', 'Transaction deleted successfully');
                    location.reload();
                } else {
                    showToast('danger', result.message || 'Failed to delete transaction');
                }
            } catch (error) {
                showToast('danger', 'An error occurred');
            } finally {
                hideLoading();
                deleteModal.hide();
            }
        });

        document.addEventListener("DOMContentLoaded", function () {
            const message = '@TempData["SuccessMessage"]';
            if (message) showToast('success', message);
        });
    </script>
}