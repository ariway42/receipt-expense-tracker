@model EditTransactionViewModel
@{
    ViewData["Title"] = "Edit Transaction";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="StoreName" class="form-label fw-medium"></label>
                    <input asp-for="StoreName" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label asp-for="TransactionDate" class="form-label fw-medium"></label>
                    <input asp-for="TransactionDate" class="form-control" type="date" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-medium">Total Amount</label>
                    <div class="input-group">
                        <span class="input-group-text">Rp</span>

                        <input id="TotalAmountDisplay"
                               class="form-control"
                               autocomplete="off" />

                        <input type="hidden" asp-for="TotalAmount" id="TotalAmount" />
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div id="itemsContainer">
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    <div class="row g-2 mb-2 item-row">
                        <input type="hidden" name="Items[@i].Id" value="@Model.Items[i].Id" />

                        <div class="col-md-6">
                            <input type="text" name="Items[@i].ItemName"
                                   value="@Model.Items[i].ItemName"
                                   class="form-control" />
                        </div>

                        <div class="col-md-3">
                            <input type="text"
                                   class="form-control price-input"
                                   value="@Model.Items[i].Price" />
                            <input type="hidden" name="Items[@i].Price"
                                   value="@Model.Items[i].Price" />
                        </div>

                        <div class="col-md-2">
                            <input type="number" name="Items[@i].Quantity"
                                   value="@Model.Items[i].Quantity"
                                   class="form-control" min="1" />
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex gap-3 mt-4">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    Save
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function formatRupiah(value) {
        if (!value) return "";

        let numberString = value.toString().replace(/\D/g, "");
        return numberString.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    }

    function parseNumber(value) {
        if (!value) return "";
        return value.toString().replace(/\D/g, "");
    }

    const display = document.getElementById("TotalAmountDisplay");
    const hidden = document.getElementById("TotalAmount");

    const initTotal = Math.round(Number("@Model.TotalAmount"));

    display.value = formatRupiah(initTotal);
    hidden.value = initTotal;

    display.addEventListener("input", function () {
        let raw = parseNumber(this.value);

        hidden.value = raw;
        this.value = formatRupiah(raw);
    });

    document.querySelectorAll(".price-input").forEach((input) => {
        const hiddenInput = input.nextElementSibling;

        let init = Math.round(Number(input.value));

        input.value = formatRupiah(init);
        hiddenInput.value = init;

        input.addEventListener("input", function () {
            let raw = parseNumber(this.value);

            hiddenInput.value = raw;
            this.value = formatRupiah(raw);
        });
    });
</script>