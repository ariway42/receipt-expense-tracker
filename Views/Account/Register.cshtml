@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Finansia</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .register-card {
            background: white;
            border-radius: 1.5rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            max-width: 450px;
            width: 100%;
        }

        .register-header {
            background: linear-gradient(135deg, #10B981 0%, #14B8A6 100%);
            padding: 2rem;
            text-align: center;
        }

            .register-header h1 {
                color: white;
                font-size: 1.5rem;
                font-weight: 700;
                margin-bottom: 0.5rem;
            }

            .register-header p {
                color: rgba(255, 255, 255, 0.9);
                font-size: 0.9rem;
                margin: 0;
            }

        .register-icon {
            width: 60px;
            height: 60px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
        }

            .register-icon i {
                font-size: 1.75rem;
                color: white;
            }

        .register-body {
            padding: 2rem;
        }

        .form-control {
            border-radius: 0.75rem;
            padding: 0.75rem 1rem;
            border: 1px solid #e2e8f0;
            transition: all 0.2s ease;
        }

            .form-control:focus {
                border-color: #10B981;
                box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
            }

        .input-group-text {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-right: none;
            border-radius: 0.75rem 0 0 0.75rem;
        }

        .btn-register {
            background: linear-gradient(135deg, #10B981 0%, #14B8A6 100%);
            border: none;
            padding: 0.875rem;
            border-radius: 0.75rem;
            font-weight: 600;
            color: white;
            width: 100%;
            transition: all 0.2s ease;
        }

            .btn-register:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
                color: white;
            }

        .links {
            text-align: center;
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid #e2e8f0;
        }

        .password-requirements {
            font-size: 0.75rem;
            color: #64748b;
            margin-top: 0.5rem;
        }
    </style>
</head>
<body>
    <div class="register-card">
        <div class="register-header">
            <div class="register-icon">
                <i class="bi bi-person-plus"></i>
            </div>
            <h1>Buat Akun</h1>
            <p>Mulai untuk mengelola pengeluaran kamu hari ini</p>
        </div>

        <div class="register-body">
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-sm"></div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="FirstName" class="form-label fw-medium">Nama depan</label>
                        <input asp-for="FirstName" class="form-control" placeholder="Nama depan" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="LastName" class="form-label fw-medium">Nama Belakang</label>
                        <input asp-for="LastName" class="form-control" placeholder="Nama belakang" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-medium">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="Masukan Email kamu" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-medium">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Masukkan password kamu" />
                    </div>
                    <div class="password-requirements">
                        Minimal 6 karakter, mengandung huruf besar, huruf kecil, dan angka.
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-medium">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Konfirmasi password kamu" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-register">
                    <i class="bi bi-person-check me-2"></i>Buat Akun
                </button>
            </form>

            <div class="links">
                <p class="text-muted small mb-0">
                    Sudah Punya Akun? <a asp-action="Login" class="fw-medium text-success">Masuk disini</a>
                </p>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
